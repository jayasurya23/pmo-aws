# Copy to .env to override defaults. Every value is local-only.
# There are deliberately NO Monday, Microsoft Graph, Entra, SharePoint or OpenAI settings:
# the demo cannot reach any of those services (see backend/app/netguard.py).

POSTGRES_USER=pmo_demo
POSTGRES_PASSWORD=pmo_demo_local
POSTGRES_DB=pmo360_demo

# Deterministic synthetic world: same seed + as-of date = identical data and screenshots.
DEMO_SEED=360
DEMO_AS_OF=2026-11-20

WEB_PORT=8080
API_PORT=8000
